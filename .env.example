# CapMint Environment Variables Template (.env.example)
# Copy this file to .env and configure the local secret values. Never commit a real .env.

# 1. Operational Environment
NODE_ENV=development
# Do not set PORT globally: frontend is fixed at 8080; backends use defaults auth 8081, cpq 8082, mint 8083, resolver 8084, transparency 8085, verification 8086, integration 8087.
# Public base URL of the local gateway/frontend proxy (scripts/frontend-server.js).
BASE_URL=http://localhost:8080

# 2. Database Connection (PostgreSQL) — DM-04 Row-Level Security role split
#
# Since DM-04, the six backend SERVICES connect as the NON-OWNER role
# `capmint_app` (subject to RLS). MIGRATIONS, first-admin bootstrap, and the
# development seed connect as the OWNER `capmint_admin` (which bypasses RLS so it
# can create/alter/seed). After migration 0015 exists, provision the app login:
#   ALTER ROLE capmint_app LOGIN PASSWORD '<capmint_app_password>';
# Then point each service's DATABASE_URL at capmint_app (below), and run
# migration/seed commands with DATABASE_URL overridden to the admin URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capmint_dev

# Runtime services (RLS-enforced, non-owner):
DATABASE_URL=postgres://capmint_app:<capmint_app_password>@localhost:5432/capmint_dev

# Owner URL for migrations / bootstrap / seed only (bypasses RLS). Supply it as
# DATABASE_URL when running those commands, e.g.:
#   DATABASE_URL="$ADMIN_DATABASE_URL" node playground/run_migrations.js --apply
ADMIN_DATABASE_URL=postgres://capmint_admin:capmint_secure_password@localhost:5432/capmint_dev

# Safety guard: destructive dev DB operations refuse to act on a database whose
# name does not start with this prefix.
CAPMINT_EXPECTED_DATABASE_PREFIX=capmint_

# 3. Cache & Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=capmint_redis_secure_password
REDIS_URL=redis://:capmint_redis_secure_password@localhost:6379/0
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_VERIFY_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# 4. Inter-service URLs
# Internal transparency ledger endpoint the verification service appends to.
TRANSPARENCY_SERVICE_URL=http://localhost:8085
# Consumer verification frontend the resolver redirects scans to.
VERIFY_FRONTEND_URL=http://localhost:8080

# 5. Security Keys
# Secret for signing session tokens (HMAC-SHA256; minimum 32 bytes).
JWT_SECRET=capmint_development_jwt_secret_must_be_minimum_32_bytes_long
# Webhook subscriber shared secret.
WEBHOOK_SECRET=capmint_webhook_secret_for_local_verifications
# Allowed CORS origin.
CORS_ORIGIN=http://localhost:8080

# 6. One-time operator bootstrap. Inject production values from a secret store;
# never keep real bootstrap credentials in this file.
CAPMINT_BOOTSTRAP_ADMIN_USERNAME=
CAPMINT_BOOTSTRAP_ADMIN_ORG_NAME=
CAPMINT_BOOTSTRAP_ADMIN_EMAIL=
CAPMINT_BOOTSTRAP_ADMIN_PASSWORD=

# 7. Explicit development/test fixtures. The seed also requires NODE_ENV to be
# development, test, or integration. Never enable in production.
CAPMINT_ALLOW_DEVELOPMENT_SEED=0
CAPMINT_DEVELOPMENT_SEED_PASSWORD=
CAPMINT_DEVELOPMENT_CERTIFIER_PRIVATE_KEY=
CAPMINT_DEVELOPMENT_CERTIFIER_PUBLIC_KEY=

# 8. Certifier signing keys (Ed25519). Generate your OWN locally; never commit real keys:
#   openssl genpkey -algorithm ed25519 -out certifier.pem
# Paste each PEM as a single line with literal \n between lines.
CERTIFIER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<REPLACE_WITH_YOUR_OWN_ED25519_PRIVATE_KEY>\n-----END PRIVATE KEY-----"
CERTIFIER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<REPLACE_WITH_YOUR_OWN_ED25519_PUBLIC_KEY>\n-----END PUBLIC KEY-----"
